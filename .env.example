# ERPNext connection — server-side only, never expose to browser
ERPNEXT_BASE_URL=https://your-site.boraerp.co.ke
ERPNEXT_API_KEY=your_api_key_here
ERPNEXT_API_SECRET=your_api_secret_here

# Must be the exact name of an existing Customer record in ERPNext
# Create a "254Sports Walk-in" customer in ERPNext if it doesn't exist
ERPNEXT_GUEST_CUSTOMER=254Sports Walk-in
